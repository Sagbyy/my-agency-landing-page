---
import firstIllustration from "../../assets/process/process-illustration-1.png";
import secondIllustration from "../../assets/process/process-illustration-2.png";
import thirdIllustration from "../../assets/process/process-illustration-3.png";
import fourthIllustration from "../../assets/process/process-illustration-4.png";
import fourthBackground from "../../assets/process/process-bg-4.png";
import { translations, type Lang } from "../../i18n/translations";

const lang = (Astro.currentLocale ?? "en") as Lang;
const t = translations[lang].process;

const illustrations = [firstIllustration, secondIllustration, thirdIllustration];
const steps = t.steps.map((step, i) => ({ ...step, illustration: illustrations[i] }));
const last = { ...t.last, illustration: fourthIllustration, bg: fourthBackground };
---

<section id="process" class="bg-white py-20 md:py-28">
  <div class="container mx-auto px-7 md:px-0">
    <div class="mx-auto mb-16 flex max-w-3xl flex-col gap-4 text-center">
      <p class="process-anim text-xl text-black">{t.num}</p>
      <p
        class="process-anim text-lg font-extralight tracking-[25%] text-black uppercase lg:text-xl"
      >
        {t.tag}
      </p>
      <h2
        class="process-anim font-urbanist text-4xl leading-tight font-medium text-black lg:text-5xl"
      >
        {t.title}
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      <div class="flex flex-col gap-4">
        {
          steps.map((step) => (
            <article class="process-card flex flex-col items-center overflow-hidden rounded-2xl bg-[#F8F8F9] p-6 text-black md:px-8 lg:flex-row">
              <div>
                <h3 class="mb-2 text-lg font-semibold text-black">{step.title}</h3>
                <p class="text-sm leading-relaxed text-gray-600">{step.description}</p>
              </div>
              <img
                src={step.illustration.src}
                alt={step.alt}
                class="max-h-[180px] object-contain"
              />
            </article>
          ))
        }
      </div>

      <article
        class="process-card-last flex min-h-[250px] flex-col justify-end overflow-hidden rounded-2xl p-6 text-white md:p-8 lg:min-h-[400px]"
        style={`background-image: url(${last.bg.src}); background-size: cover; background-position: center;`}
      >
        <div class="mb-6 flex flex-1 items-center justify-center">
          <img
            src={last.illustration.src}
            alt={last.alt}
            class="max-h-[200px] object-contain md:max-h-[320px]"
          />
        </div>
        <h3 class="mb-2 text-xl font-semibold lg:text-2xl">{last.title}</h3>
        <p class="text-base leading-relaxed text-white/80">
          {last.description}
        </p>
      </article>
    </div>
  </div>
</section>

<style>
  .process-anim,
  .process-card,
  .process-card-last {
    opacity: 0;
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initProcessAnimations() {
    const section = document.getElementById("process");
    if (!section) return;

    gsap.fromTo(
      section.querySelectorAll(".process-anim"),
      { opacity: 0, y: 40 },
      {
        opacity: 1,
        y: 0,
        duration: 0.6,
        stagger: 0.1,
        ease: "power3.out",
        scrollTrigger: {
          trigger: section,
          start: "top 75%",
          toggleActions: "play none none none",
        },
      },
    );

    gsap.fromTo(
      section.querySelectorAll(".process-card"),
      { opacity: 0, x: -40 },
      {
        opacity: 1,
        x: 0,
        duration: 0.6,
        stagger: 0.15,
        ease: "power3.out",
        scrollTrigger: {
          trigger: section.querySelector(".process-card"),
          start: "top 80%",
          toggleActions: "play none none none",
        },
      },
    );

    gsap.fromTo(
      section.querySelector(".process-card-last"),
      { opacity: 0, x: 40 },
      {
        opacity: 1,
        x: 0,
        duration: 0.7,
        ease: "power3.out",
        scrollTrigger: {
          trigger: section.querySelector(".process-card-last"),
          start: "top 80%",
          toggleActions: "play none none none",
        },
      },
    );
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initProcessAnimations);
  } else {
    initProcessAnimations();
  }
</script>
