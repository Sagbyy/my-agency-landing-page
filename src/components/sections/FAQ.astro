---
import backgroundCard from "../../assets/faq/background-card.png";
import Button from "../ui/Button.astro";
import { Icon } from "astro-icon/components";
import { translations, type Lang } from "../../i18n/translations";

const lang = (Astro.currentLocale ?? "en") as Lang;
const t = translations[lang].faq;
---

<section id="faq" class="bg-[#F0F0F2] py-20 md:py-28">
  <div class="container mx-auto px-7 md:px-0">
    <div
      class="faq-header mx-auto mb-12 flex max-w-3xl flex-col gap-4 text-center"
    >
      <p class="text-xl text-black">{t.num}</p>
      <p
        class="text-lg font-extralight tracking-[25%] text-black uppercase lg:text-xl"
      >
        {t.tag}
      </p>
      <h2
        class="font-urbanist text-4xl leading-tight font-medium text-black lg:text-5xl"
      >
        {t.title}
      </h2>
    </div>
    <div class="mx-auto flex max-w-3xl flex-col gap-3">
      {
        t.items.map((faq, i) => (
          <details
            class="faq-item collapse-plus collapse rounded-2xl border-none bg-white"
            name="faq"
            open={i === 0 ? true : undefined}
          >
            <summary class="collapse-title min-h-0 py-5 pr-16 pl-6 text-base font-semibold md:text-lg">
              {faq.question}
            </summary>
            <div class="collapse-content px-6 pb-6">
              <p class="faq-answer text-sm leading-relaxed md:text-base">
                {faq.answer}
              </p>
            </div>
          </details>
        ))
      }
    </div>

    <div
      class="faq-cta mx-auto mt-10 flex max-w-3xl flex-col items-center gap-4"
    >
      <div
        class="flex w-full flex-col justify-between gap-4 rounded-3xl p-4 md:flex-row md:items-center md:gap-0 md:rounded-full md:p-2"
        style={{
          backgroundImage: `url(${backgroundCard.src})`,
          backgroundSize: "100%",
          backgroundPosition: "bottom",
          backgroundRepeat: "no-repeat",
        }}
      >
        <div class="flex items-center gap-3">
          <div
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white"
          >
            <Icon name="mdi:chat-bubble-outline" class="h-4 w-4" />
          </div>
          <span class="text-base font-semibold text-white md:text-lg"
            >{t.ctaQuestion}</span
          >
        </div>
        <Button
          href="#contact"
          text={t.ctaBtn}
          color="white"
          className="w-full md:w-auto"
        />
      </div>
      <p class="text-sm text-gray-400">{t.ctaOr}</p>
      <a
        href="mailto:contact@sagency.tech"
        class="flex items-center gap-2 text-sm font-medium text-black underline underline-offset-4"
      >
        <Icon name="mdi:email-outline" class="h-4 w-4" />
        contact@sagency.tech
      </a>
    </div>
  </div>
</section>

<style>
  .faq-header,
  .faq-item,
  .faq-cta {
    opacity: 0;
  }

  .faq-item.collapse-plus > summary::after {
    top: 40%;
    transform: translateY(-60%);
    right: 1.5rem;
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function init() {
    const section = document.getElementById("faq");
    if (!section) return;

    gsap.fromTo(
      section.querySelector(".faq-header"),
      { opacity: 0, y: 40 },
      {
        opacity: 1,
        y: 0,
        duration: 0.6,
        ease: "power3.out",
        scrollTrigger: {
          trigger: section,
          start: "top 75%",
          toggleActions: "play none none none",
        },
      },
    );

    gsap.fromTo(
      section.querySelectorAll(".faq-item"),
      { opacity: 0, y: 30 },
      {
        opacity: 1,
        y: 0,
        duration: 0.5,
        stagger: 0.1,
        ease: "power3.out",
        scrollTrigger: {
          trigger: section.querySelector(".faq-item"),
          start: "top 80%",
          toggleActions: "play none none none",
        },
      },
    );

    gsap.fromTo(
      section.querySelector(".faq-cta"),
      { opacity: 0, y: 24 },
      {
        opacity: 1,
        y: 0,
        duration: 0.5,
        ease: "power3.out",
        scrollTrigger: {
          trigger: section.querySelector(".faq-cta"),
          start: "top 90%",
          toggleActions: "play none none none",
        },
      },
    );
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
