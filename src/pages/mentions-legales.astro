---
import { Icon } from "astro-icon/components";
import MainLayout from "../layouts/MainLayout.astro";
import Footer from "../components/sections/Footer.astro";
import backgroundCard from "../assets/faq/background-card.png";
---

<MainLayout
  title="Legal Notices — Sagency"
  description="Legal notices of Sagency, digital development agency."
  canonical="https://www.sagency.tech/mentions-legales"
  noindex={true}
>
  <main class="mx-auto max-w-4xl px-7 pt-40 pb-24 lg:px-0">
    <div class="mb-16">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-sm text-neutral-500 transition-colors hover:text-black"
      >
        <Icon name="ri:arrow-left-line" class="h-4 w-4" />
        Back to home
      </a>

      <h1 class="font-urbanist mt-8 text-5xl font-semibold md:text-6xl">
        Legal Notices
      </h1>
      <p class="mt-4 text-neutral-500">Last updated: March 2026</p>
    </div>

    <div class="flex flex-col gap-12">
      <section>
        <h2 class="font-urbanist mb-4 text-2xl font-semibold">
          1. Publisher
        </h2>
        <div class="rounded-2xl border border-neutral-200 p-6 text-neutral-700">
          <p><strong>Company name:</strong> Sagency</p>
          <p class="mt-2">
            <strong>Legal form:</strong> Sole proprietorship (Micro-entreprise)
          </p>
          <p class="mt-2"><strong>SIRET:</strong> 920 035 342</p>
          <p class="mt-2">
            <strong>Registered address:</strong> 60 Rue François 1er, 75008 Paris, France
          </p>
          <p class="mt-2"><strong>Phone:</strong> +33 7 83 13 14 66</p>
          <p class="mt-2">
            <strong>Email:</strong>
            <a
              href="mailto:contact@sagency.tech"
              class="text-black underline underline-offset-4 hover:text-neutral-600"
            >
              contact@sagency.tech
            </a>
          </p>
          <p class="mt-2">
            <strong>Publication director:</strong> Salahe-eddine Bouhdjeur
          </p>
        </div>
      </section>

      <section>
        <h2 class="font-urbanist mb-4 text-2xl font-semibold">2. Hosting</h2>
        <div class="rounded-2xl border border-neutral-200 p-6 text-neutral-700">
          <p>
            <strong>Company:</strong> Railway Corp
          </p>
          <p class="mt-2">
            <strong>Address:</strong> 548 Market St PMB 68956, San Francisco, CA
            94104, USA
          </p>
          <p class="mt-2">
            <strong>Website:</strong>
            <a
              href="https://railway.com/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-black underline underline-offset-4 hover:text-neutral-600"
              >railway.com</a
            >
          </p>
        </div>
      </section>

      <section>
        <h2 class="font-urbanist mb-4 text-2xl font-semibold">
          3. Intellectual Property
        </h2>
        <p class="leading-relaxed text-neutral-700">
          All elements of this website (texts, graphics, software, photographs,
          images, sounds, plans, logos, trademarks, etc.) are the exclusive
          property of Sagency or its partners and are protected by the
          provisions of intellectual property law.
        </p>
        <p class="mt-4 leading-relaxed text-neutral-700">
          Any reproduction, representation, modification, publication,
          transmission, distortion, in whole or in part of the site or its
          content, by any means and on any medium, is prohibited without the
          prior written consent of Sagency.
        </p>
      </section>

      <section>
        <h2 class="font-urbanist mb-4 text-2xl font-semibold">
          4. Personal Data Protection (GDPR)
        </h2>

        <div class="flex flex-col gap-6 text-neutral-700">
          <div>
            <h3 class="mb-2 font-semibold text-black">
              4.1 Data Controller
            </h3>
            <p class="leading-relaxed">
              The data controller for personal data collected on this site is
              Sagency, reachable at: <a
                href="mailto:contact@sagency.tech"
                class="text-black underline underline-offset-4 hover:text-neutral-600"
                >contact@sagency.tech</a
              >.
            </p>
          </div>

          <div>
            <h3 class="mb-2 font-semibold text-black">
              4.2 Data Collected
            </h3>
            <p class="leading-relaxed">
              In the context of using this site, we collect the following data:
            </p>
            <ul class="mt-3 flex flex-col gap-2 pl-5">
              <li class="list-disc">
                <strong>Contact form:</strong> name, email address, and the content
                of your message.
              </li>
              <li class="list-disc">
                <strong>Browsing data:</strong> IP address, browser type, pages
                visited, duration of visits.
              </li>
            </ul>
          </div>

          <div>
            <h3 class="mb-2 font-semibold text-black">
              4.3 Purposes and Legal Basis
            </h3>
            <div class="overflow-x-auto">
              <table class="w-full border-collapse text-sm">
                <thead>
                  <tr class="border-b border-neutral-200">
                    <th class="py-3 pr-4 text-left font-semibold text-black"
                      >Purpose</th
                    >
                    <th class="py-3 pr-4 text-left font-semibold text-black"
                      >Legal basis</th
                    >
                  </tr>
                </thead>
                <tbody class="divide-y divide-neutral-100">
                  <tr>
                    <td class="py-3 pr-4">Responding to contact requests</td>
                    <td class="py-3">Legitimate interest (Art. 6.1.f GDPR)</td>
                  </tr>
                  <tr>
                    <td class="py-3 pr-4">Managing prospects and quotes</td>
                    <td class="py-3"
                      >Pre-contractual measures (Art. 6.1.b GDPR)</td
                    >
                  </tr>
                  <tr>
                    <td class="py-3 pr-4">Site improvement (analytics)</td>
                    <td class="py-3">Consent (Art. 6.1.a GDPR)</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <div>
            <h3 class="mb-2 font-semibold text-black">
              4.4 Retention Period
            </h3>
            <ul class="flex flex-col gap-2 pl-5">
              <li class="list-disc">
                Contact data: 3 years from the last contact.
              </li>
              <li class="list-disc">
                Browsing data: maximum 13 months.
              </li>
              <li class="list-disc">
                Contractual data: 5 years from the end of the contractual
                relationship.
              </li>
            </ul>
          </div>

          <div>
            <h3 class="mb-2 font-semibold text-black">
              4.5 Data Recipients
            </h3>
            <p class="leading-relaxed">
              The data collected is intended exclusively for Sagency. It is
              neither sold, rented, nor transferred to third parties. It may be
              shared with technical subcontractors (hosting, emailing tools)
              strictly within the scope of the service, under a data processing
              agreement compliant with the GDPR.
            </p>
          </div>

          <div>
            <h3 class="mb-2 font-semibold text-black">4.6 Your Rights</h3>
            <p class="leading-relaxed">
              In accordance with EU Regulation 2016/679 (GDPR), you have the
              following rights regarding your personal data:
            </p>
            <ul class="mt-3 flex flex-col gap-2 pl-5">
              <li class="list-disc">
                <strong>Right of access</strong>: obtain a copy of the data
                concerning you.
              </li>
              <li class="list-disc">
                <strong>Right of rectification</strong>: correct inaccurate or
                incomplete data.
              </li>
              <li class="list-disc">
                <strong>Right to erasure</strong>: request deletion of your
                data ("right to be forgotten").
              </li>
              <li class="list-disc">
                <strong>Right to restriction</strong>: temporarily restrict the
                processing of your data.
              </li>
              <li class="list-disc">
                <strong>Right to object</strong>: object to the processing of
                your data.
              </li>
              <li class="list-disc">
                <strong>Right to data portability</strong>: receive your data in
                a structured, machine-readable format.
              </li>
            </ul>
            <p class="mt-4 leading-relaxed">
              To exercise these rights, contact us at <a
                href="mailto:contact@sagency.tech"
                class="text-black underline underline-offset-4 hover:text-neutral-600"
                >contact@sagency.tech</a
              >. If you receive an unsatisfactory response, you may file a
              complaint with the <strong>CNIL</strong> (French Data Protection
              Authority): <a
                href="https://www.cnil.fr"
                target="_blank"
                rel="noopener noreferrer"
                class="text-black underline underline-offset-4 hover:text-neutral-600"
                >www.cnil.fr</a
              >.
            </p>
          </div>
        </div>
      </section>

      <section>
        <h2 class="font-urbanist mb-4 text-2xl font-semibold">
          5. Cookie Policy
        </h2>
        <div class="flex flex-col gap-4 text-neutral-700">
          <p class="leading-relaxed">
            A cookie is a small text file placed on your device (computer,
            tablet, smartphone) during your browsing. Cookies allow us to
            measure site traffic and improve your experience.
          </p>
          <div>
            <h3 class="mb-2 font-semibold text-black">Cookies used</h3>
            <div class="overflow-x-auto">
              <table class="w-full border-collapse text-sm">
                <thead>
                  <tr class="border-b border-neutral-200">
                    <th class="py-3 pr-4 text-left font-semibold text-black"
                      >Type</th
                    >
                    <th class="py-3 pr-4 text-left font-semibold text-black"
                      >Purpose</th
                    >
                    <th class="py-3 text-left font-semibold text-black"
                      >Duration</th
                    >
                  </tr>
                </thead>
                <tbody class="divide-y divide-neutral-100">
                  <tr>
                    <td class="py-3 pr-4">Technical cookies</td>
                    <td class="py-3 pr-4">Site functionality</td>
                    <td class="py-3">Session</td>
                  </tr>
                  <tr>
                    <td class="py-3 pr-4">Analytics cookies</td>
                    <td class="py-3 pr-4">Audience measurement (if enabled)</td>
                    <td class="py-3">13 months</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
          <p class="leading-relaxed">
            You can configure your browser at any time to refuse or delete
            cookies. However, this may affect certain features of the site.
          </p>
        </div>
      </section>

      <section>
        <h2 class="font-urbanist mb-4 text-2xl font-semibold">
          6. Limitation of Liability
        </h2>
        <p class="leading-relaxed text-neutral-700">
          Sagency makes every effort to ensure the accuracy and currency of
          information published on this site. However, Sagency cannot guarantee
          the accuracy, precision, or completeness of the information made
          available. Sagency reserves the right to correct, at any time and
          without notice, the content of this site.
        </p>
        <p class="mt-4 leading-relaxed text-neutral-700">
          Sagency shall not be held liable for the use made of this information,
          any errors it may contain, or any direct or indirect damages that may
          result from accessing or using the site.
        </p>
      </section>

      <section>
        <h2 class="font-urbanist mb-4 text-2xl font-semibold">
          7. Applicable Law
        </h2>
        <p class="leading-relaxed text-neutral-700">
          This site and its legal notices are governed by French law. In the
          event of a dispute, and failing amicable resolution, French courts
          shall have sole jurisdiction.
        </p>
      </section>

      <section
        class="rounded-2xl bg-black p-8 text-white"
        style={{
          backgroundImage: `url(${backgroundCard.src})`,
          backgroundSize: "cover",
          backgroundPosition: "center",
          backgroundRepeat: "no-repeat",
        }}
      >
        <h2 class="font-urbanist mb-3 text-2xl font-semibold">
          A question about your data?
        </h2>
        <p class="leading-relaxed text-neutral-300">
          For any request regarding your personal data or the exercise of your
          rights, contact us directly.
        </p>
        <a
          href="/#contact"
          class="mt-5 inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-semibold text-black transition-colors hover:bg-neutral-200"
        >
          Contact us
        </a>
      </section>
    </div>
  </main>

  <Footer />
</MainLayout>
